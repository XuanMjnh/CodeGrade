# Run python scripts/init_env.py --demo, or copy this file to .env and fill in the values.
# ADMIN_PASSWORD: 10-72 characters. WORKER_TOKEN: at least 32 characters.
# With DEMO_DATA=true, set DEMO_PASSWORD (10-72 characters) to load sample problems/users.
PORT=8080
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
ADMIN_PASSWORD=
WORKER_TOKEN=
DEMO_DATA=false
DEMO_PASSWORD=
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SURVIVAL_RATING_RANGES=150,250,350,400
SURVIVAL_RANK_THRESHOLDS=1100,1300,1500,1700,1900
SURVIVAL_K_FACTOR=32
SURVIVAL_ACCEPT_SECONDS=20
